# Copia este archivo a functions/.env y ajusta los valores.
# functions/.env NO se sube a git (ver .gitignore).

# URL pública de tu portal de clientes (la carpeta portal/ publicada), sin
# barra final. Se usa para volver aquí después de pagar en Mercado Pago.
PORTAL_URL=https://tu-usuario.github.io/tu-repo/portal

# Moneda para Mercado Pago. Perú = PEN.
MERCADOPAGO_CURRENCY=PEN

# Cada cuántos días se activa el acceso por cada pago del portal.
PORTAL_CICLO_DIAS=30
