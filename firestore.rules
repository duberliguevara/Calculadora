rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // Antes de crear system/config (paso del portal de clientes, ver
      // portal/README.md) todavía no hay forma de distinguir "el
      // administrador" de cualquier otra cuenta, así que se permite
      // cualquier usuario con sesión iniciada — solo tú tienes cuenta en
      // ese punto. En cuanto exista system/config, se exige que coincida
      // con el UID guardado ahí.
      return request.auth != null
        && (
          !exists(/databases/$(database)/documents/system/config)
          || request.auth.uid == get(/databases/$(database)/documents/system/config).data.adminUid
        );
    }

    match /clients/{clientId} {
      // El administrador tiene control total sobre sus propios clientes.
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId;

      // Un cliente que se registró solo en el portal puede leer (no editar)
      // su propio registro, para ver su estado y fecha de vencimiento.
      allow read: if request.auth != null
        && request.auth.uid == resource.data.customerUid;
    }

    match /plans/{planId} {
      // Cualquier usuario con sesión iniciada puede ver los planes/combos
      // (el portal los necesita para mostrar el catálogo a los clientes).
      allow read: if request.auth != null;
      // Solo el administrador puede crearlos/editarlos/borrarlos.
      allow write: if isAdmin();
    }

    match /checkouts/{checkoutId} {
      // Un cliente puede ver sus propios intentos de pago, pero nunca
      // escribir aquí directamente: eso lo hacen solo las Cloud Functions
      // (con el SDK de administrador, que no pasa por estas reglas), para
      // que nadie pueda "regalarse" un pago aprobado desde el navegador.
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    match /system/{docId} {
      // Configuración interna (system/config con el UID del administrador,
      // system/netflixSession con la sesión del bot). Nunca accesible desde
      // el navegador, ni siquiera de lectura; solo el SDK de administrador.
      allow read, write: if false;
    }
  }
}
